# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER expose to the client.
# Used by scripts/create-admin.mjs and any privileged server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Stripe (payments) — app runs without these, checkout falls back to "manual/COD" mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: "Buy the developer a coffee" link shown in the footer.
# Falls back to a generic buymeacoffee.com link if unset.
NEXT_PUBLIC_COFFEE_URL=https://www.buymeacoffee.com/your-username
